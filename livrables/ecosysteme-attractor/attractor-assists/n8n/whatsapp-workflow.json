        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-haiku-4-5-20251001\",\n  \"max_tokens\": 1024,\n  \"system\": \"Tu es Assists, le bras droit intelligent de Mac Arthur (Mr Attractor). Tu reponds en francais, directement, sans blabla. Tes messages sont courts et adaptes a WhatsApp. Tu aides avec la vente (PPSD, AIDA, PASA), l'organisation (3 fuites : temps/argent/attention) et le contenu.\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"{{$json[\\\"text\\\"]}}\"\n    }\n  ]\n}"
      },
