      "name": "Des prospects ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().flatMap(item => Array.isArray(item.json) ? item.json.map(p => ({json: p})) : [{json: item.json}]);"
      },
      "id": "node-split",
      "name": "Split prospects",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-api-key", "value": "={{ $env.ANTHROPIC_API_KEY }}" },
            { "name": "anthropic-version", "value": "2023-06-01" },
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": []
        },
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-haiku-4-5-20251001\",\n  \"max_tokens\": 512,\n  \"system\": \"Tu es l'assistant de Mac Arthur, fondateur de l'agence Mr Attractor (CI + diaspora France).\\nTu rédiges des messages WhatsApp COURTS, naturels, directs, SANS emojis, SANS markdown, SANS formule d'accueil artificielle.\\nMac Arthur enverra ce message en son nom. Écris comme lui : humain, pro, direct.\\nDonne aussi une note de qualification en 1 ligne (secteur détecté, besoin, urgence estimée).\\n\\nFormat de réponse OBLIGATOIRE (respecte exactement ces labels) :\\nMESSAGE_WA: [le message, 2-3 phrases max]\\nQUALIFICATION: [une ligne : secteur, besoin, urgence]\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Prospect reçu via site web.\\nPrénom: {{ $json.prenom }}\\nActivité: {{ $json.activite }}\\nBesoin principal: {{ $json.besoin }}\\nZone: {{ $json.zone }}\\n\\nGénère le MESSAGE_WA et la QUALIFICATION.\"\n    }\n  ]\n}"
      },
      "id": "node-claude",
      "name": "Claude — Draft WA + Qualification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 220]
    },
    {
      "parameters": {
        "jsCode": "const prospect = $('Split prospects').first().json;\nconst raw = $input.first().json.content?.[0]?.text || '';\n\nconst waMatch   = raw.match(/MESSAGE_WA:\\s*([\\s\\S]*?)(?=QUALIFICATION:|$)/);\nconst qualMatch = raw.match(/QUALIFICATION:\\s*([\\s\\S]*?)$/);\n\nconst waDraft   = waMatch   ? waMatch[1].trim()   : raw.trim();\nconst qualif    = qualMatch ? qualMatch[1].trim()  : '';\n\nconst zoneMap = { CI: 'CI', EU: 'France', LES2: 'CI' };\nconst zone    = zoneMap[prospect.zone] || prospect.zone || 'CI';\n\nreturn [{\n  json: {\n    prospect_id: prospect.id,\n    prenom:      prospect.prenom,\n    activite:    prospect.activite,\n    whatsapp:    prospect.whatsapp,\n    zone,\n    wa_draft:    waDraft,\n    qualification: qualif\n  }\n}];"
      },
      "id": "node-parse",
      "name": "Parser réponse Claude",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1340, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://lgdgbrivnhgeupqhkckd.supabase.co/rest/v1/pilotage_pipeline",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImxnZGdicml2bmhnZXVwcWhrY2tkIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODAwMDI1OTEsImV4cCI6MjA5NTU3ODU5MX0.kMmpwsQAUJQ6VkEpj4OOloijP1HoZbYYzbjWW2hg7Gk" },
            { "name": "Authorization", "value": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImxnZGdicml2bmhnZXVwcWhrY2tkIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODAwMDI1OTEsImV4cCI6MjA5NTU3ODU5MX0.kMmpwsQAUJQ6VkEpj4OOloijP1HoZbYYzbjWW2hg7Gk" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=representation" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"nom\": \"{{ $json.prenom }} — {{ $json.activite }}\",\n  \"contact\": \"{{ $json.whatsapp }}\",\n  \"activite\": \"{{ $json.activite }}\",\n  \"famille\": \"A\",\n  \"zone\": \"{{ $json.zone }}\",\n  \"statut\": \"En contact\",\n  \"statut_color\": \"neu\",\n  \"prochaine\": \"{{ $json.qualification }}\",\n  \"source\": \"inbound_site\",\n  \"wa_draft\": \"{{ $json.wa_draft }}\",\n  \"priorite\": 1,\n  \"urgent\": true\n}"
      },
      "id": "node-insert-pipeline",
