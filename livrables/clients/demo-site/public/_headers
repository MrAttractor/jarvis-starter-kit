/beynaud/manifest.webmanifest
  Content-Type: application/manifest+json

# Les images de la Beynaumania etaient renvoyees en "max-age=0, must-revalidate" :
# chaque ouverture de la page repayait un aller-retour reseau pour s'entendre dire
# que la photo n'avait pas bouge. Une semaine de cache supprime cet aller-retour
# pour un fan qui revient. Regle a retenir : pour remplacer une de ces images,
# changer son nom de fichier, ne pas ecraser l'ancienne.
/beynaud/*.webp
  Cache-Control: public, max-age=604800
/beynaud/*.jpg
  Cache-Control: public, max-age=604800
/beynaud/*.png
  Cache-Control: public, max-age=604800
